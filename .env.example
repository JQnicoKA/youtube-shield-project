# Copier ce fichier en .env et remplir les valeurs (Google Cloud Console > Identifiants).
# Ces ID clients OAuth ne sont pas des secrets, mais on les garde hors du dépôt.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx-yyyy.apps.googleusercontent.com

# Classification des commentaires offensants (Azure ML).
# ⚠️ La clé est intégrée à l'app : usage perso uniquement (voir src/config.ts).
EXPO_PUBLIC_MODERATION_URL=https://youtube-shield-api.francecentral.inference.ml.azure.com/score
EXPO_PUBLIC_MODERATION_API_KEY=

# Instagram (API with Unified Login) — ID du compte pro et jeton d'utilisateur système.
# Obtenus avec ./scripts/instagram-token.sh
EXPO_PUBLIC_IG_USER_ID=
EXPO_PUBLIC_IG_ACCESS_TOKEN=
